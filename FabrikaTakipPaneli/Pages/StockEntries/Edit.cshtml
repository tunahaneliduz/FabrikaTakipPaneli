@page "{id:int}"
@model FabrikaTakipPaneli.Pages.StockEntries.EditModel
@{
    ViewData["Title"] = "Stok Hareketi Düzenle";
}

<h1>Stok Hareketi Düzenle</h1>

<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-2">
        <label asp-for="Input.ProductId" class="control-label"></label>
        <select asp-for="Input.ProductId" asp-items="Model.ProductOptions" class="form-control"></select>
        <span asp-validation-for="Input.ProductId" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Type" class="control-label"></label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<FabrikaTakipPaneli.Models.StockEntryType>()" class="form-control"></select>
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Quantity" class="control-label"></label>
        <input asp-for="Input.Quantity" class="form-control" />
        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.UnitPrice" class="control-label"></label>
        <input asp-for="Input.UnitPrice" class="form-control" />
        <span asp-validation-for="Input.UnitPrice" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.EntryDate" class="control-label"></label>
        <input asp-for="Input.EntryDate" class="form-control" />
        <span asp-validation-for="Input.EntryDate" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Input.Note" class="control-label"></label>
        <textarea asp-for="Input.Note" class="form-control"></textarea>
        <span asp-validation-for="Input.Note" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
