@page
@model FabrikaTakipPaneli.Pages.StockEntries.CreateModel
@{
    ViewData["Title"] = "Yeni Stok Hareketi";
}

<h1><i class="bi bi-plus-lg"></i> Yeni Stok Hareketi</h1>

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-2">
        <label asp-for="Input.ProductId" class="control-label"></label>
        <select asp-for="Input.ProductId" asp-items="Model.ProductOptions" class="form-control">
            <option value="">-- Ürün seçin --</option>
        </select>
        <span asp-validation-for="Input.ProductId" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Type" class="control-label"></label>
        <select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<FabrikaTakipPaneli.Models.StockEntryType>()" class="form-control"></select>
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Quantity" class="control-label"></label>
        <input asp-for="Input.Quantity" class="form-control" />
        <span asp-validation-for="Input.Quantity" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.UnitPrice" class="control-label"></label>
        <input asp-for="Input.UnitPrice" class="form-control" />
        <span asp-validation-for="Input.UnitPrice" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.EntryDate" class="control-label"></label>
        <input asp-for="Input.EntryDate" class="form-control" />
        <span asp-validation-for="Input.EntryDate" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Input.Note" class="control-label"></label>
        <textarea asp-for="Input.Note" class="form-control"></textarea>
        <span asp-validation-for="Input.Note" class="text-danger"></span>
    </div>

    <div id="shipmentToggle" class="form-check mb-2" style="display:none;">
        <input asp-for="Input.AddShipment" class="form-check-input" id="shipmentToggleCheckbox" />
        <label asp-for="Input.AddShipment" class="form-check-label"></label>
    </div>

    <div id="shipmentSection" class="border rounded p-3 mb-3" style="display:none;">
        <h5 class="mb-3"><i class="bi bi-truck"></i> Sevkiyat Bilgisi</h5>
        <div class="form-group mb-2">
            <label asp-for="Input.Destination" class="control-label"></label>
            <input asp-for="Input.Destination" class="form-control" />
            <span asp-validation-for="Input.Destination" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.VehicleId" class="control-label"></label>
            <select asp-for="Input.VehicleId" asp-items="Model.VehicleOptions" class="form-control">
                <option value="">-- Araç seçin --</option>
            </select>
            <small class="form-text text-muted">
                Listede yok mu? <a asp-page="/Vehicles/Create" target="_blank">Yeni araç ekle <i class="bi bi-box-arrow-up-right"></i></a>
            </small>
        </div>
        <div class="form-check mb-2">
            <input asp-for="Input.IsFullLoad" class="form-check-input" />
            <label asp-for="Input.IsFullLoad" class="form-check-label"></label>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.DriverId" class="control-label"></label>
            <select asp-for="Input.DriverId" asp-items="Model.DriverOptions" class="form-control">
                <option value="">-- Sürücü seçin --</option>
            </select>
            <small class="form-text text-muted">
                Listede yok mu? <a asp-page="/Drivers/Create" target="_blank">Yeni sürücü ekle <i class="bi bi-box-arrow-up-right"></i></a>
            </small>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.DepartureTime" class="control-label"></label>
            <input asp-for="Input.DepartureTime" class="form-control" />
            <span asp-validation-for="Input.DepartureTime" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.EstimatedTravelHours" class="control-label"></label>
            <input asp-for="Input.EstimatedTravelHours" class="form-control" />
            <span asp-validation-for="Input.EstimatedTravelHours" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.CertificateInfo" class="control-label"></label>
            <textarea asp-for="Input.CertificateInfo" class="form-control"></textarea>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var typeSelect = document.getElementById('Input_Type');
            var shipmentToggle = document.getElementById('shipmentToggle');
            var shipmentToggleCheckbox = document.getElementById('shipmentToggleCheckbox');
            var shipmentSection = document.getElementById('shipmentSection');

            function updateVisibility() {
                var outSelected = typeSelect.value === '1';
                shipmentToggle.style.display = outSelected ? '' : 'none';
                shipmentSection.style.display = (outSelected && shipmentToggleCheckbox.checked) ? '' : 'none';

                if (!outSelected) {
                    shipmentToggleCheckbox.checked = false;
                }
            }

            typeSelect.addEventListener('change', updateVisibility);
            shipmentToggleCheckbox.addEventListener('change', updateVisibility);
            updateVisibility();
        })();
    </script>
}
