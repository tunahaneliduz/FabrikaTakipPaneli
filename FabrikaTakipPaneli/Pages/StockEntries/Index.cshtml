@page
@using FabrikaTakipPaneli.Models
@model FabrikaTakipPaneli.Pages.StockEntries.IndexModel
@{
    ViewData["Title"] = "Stok Hareketleri";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Stok Hareketleri</h1>
    <div class="d-flex gap-2">
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Stok Hareketi
        </a>
        <a asp-page="Index" asp-page-handler="ExportExcel"
           asp-route-SearchTerm="@Model.SearchTerm"
           asp-route-StartDate="@Model.StartDate?.ToString("yyyy-MM-dd")"
           asp-route-EndDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
           class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Excel'e Aktar
        </a>
    </div>
</div>

@if (!User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
{
    <p class="text-muted"><small><i class="bi bi-info-circle"></i> Kayıtlar sadece oluşturulduğu gün içinde (gece yarısına kadar) düzenlenebilir veya silinebilir. Bu süre geçtikten sonra yalnızca yönetici değişiklik yapabilir.</small></p>
}

<div class="mb-3">
    <label for="quickProductSearch" class="form-label"><i class="bi bi-lightning-charge"></i> Hızlı Ürün Ara</label>
    <input type="text" id="quickProductSearch" list="productNames" class="form-control form-control-lg" placeholder="Ürün adı yazın veya listeden seçin..." />
    <datalist id="productNames">
        @foreach (var name in Model.ProductNames)
        {
            <option value="@name"></option>
        }
    </datalist>
</div>

<form method="get" id="filterForm" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="SearchTerm" id="searchTermInput" value="@Model.SearchTerm" class="form-control" placeholder="Ürün adına göre ara..." />
        </div>
    </div>
    <div class="col-12">
        <label class="me-1">Başlangıç:</label>
        <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12">
        <label class="me-1">Bitiş:</label>
        <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Temizle</a>
    </div>
</form>

<div class="data-card">
    <table class="table">
        <thead>
            <tr>
                <th>Ürün</th>
                <th>Tip</th>
                <th class="text-end">Miktar</th>
                <th class="text-end">Birim Fiyat</th>
                <th class="text-end">Toplam Tutar</th>
                <th>Tarih</th>
                <th>Kullanıcı</th>
                <th>Not</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.StockEntries.Count == 0)
            {
                <tr><td colspan="9" class="data-card-empty">Hareket bulunamadı.</td></tr>
            }
            @foreach (var entry in Model.StockEntries)
            {
                <tr>
                    <td>@entry.ProductName</td>
                    <td>
                        @if (entry.Type == StockEntryType.In)
                        {
                            <span class="badge text-bg-success"><i class="bi bi-arrow-down-left"></i> Giriş</span>
                        }
                        else
                        {
                            <span class="badge text-bg-warning"><i class="bi bi-arrow-up-right"></i> Çıkış</span>
                        }
                    </td>
                    <td class="text-end font-mono">@entry.Quantity.ToString("N2")</td>
                    <td class="text-end font-mono">@(entry.UnitPrice?.ToString("N2"))</td>
                    <td class="text-end font-mono">@entry.TotalAmount.ToString("N2")</td>
                    <td class="font-mono">@entry.EntryDate.ToString("g")</td>
                    <td>@entry.UserName</td>
                    <td>
                        @entry.Note
                        @if (entry.ShipmentId.HasValue)
                        {
                            <a asp-page="/Shipments/Details" asp-route-id="@entry.ShipmentId" class="badge text-bg-primary text-decoration-none" title="Sevkiyat detayı">
                                <i class="bi bi-truck"></i> Sevkiyat
                            </a>
                        }
                    </td>
                    <td class="text-end">
                        @if (entry.CanModify)
                        {
                            <a asp-page="Edit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                        }
                        else if (entry.IsOwnEntry)
                        {
                            <span class="text-muted" title="Kayıtlar sadece oluşturulduğu gün içinde düzenlenebilir/silinebilir."><i class="bi bi-lock"></i> Süre doldu</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.SearchTerm,
        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-dd"),
        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-dd")
    }
})" />

@section Scripts {
    <script>
        (function () {
            var quickSearch = document.getElementById('quickProductSearch');
            var searchTermInput = document.getElementById('searchTermInput');
            var filterForm = document.getElementById('filterForm');

            quickSearch.value = searchTermInput.value;

            quickSearch.addEventListener('change', function () {
                searchTermInput.value = quickSearch.value;
                filterForm.submit();
            });
        })();
    </script>
}
