@page "{id:int}"
@model FabrikaTakipPaneli.Pages.StockEntries.DeleteModel
@{
    ViewData["Title"] = "Stok Hareketi Sil";
}

<h1><i class="bi bi-trash"></i> Stok Hareketi Sil</h1>

@if (!User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
{
    <p class="text-muted"><small><i class="bi bi-info-circle"></i> Kayıtlar sadece oluşturulduğu gün içinde silinebilir.</small></p>
}

<h3>Bu stok hareketini silmek istediğinize emin misiniz?</h3>

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
    <dl class="row">
        <dt class="col-sm-3">Ürün</dt>
        <dd class="col-sm-9">@Model.ProductName</dd>
        <dt class="col-sm-3">Tip</dt>
        <dd class="col-sm-9">@(Model.Type == FabrikaTakipPaneli.Models.StockEntryType.In ? "Giriş" : "Çıkış")</dd>
        <dt class="col-sm-3">Miktar</dt>
        <dd class="col-sm-9">@Model.Quantity.ToString("N2")</dd>
        <dt class="col-sm-3">Tarih</dt>
        <dd class="col-sm-9">@Model.EntryDate.ToString("g")</dd>
        <dt class="col-sm-3">Not</dt>
        <dd class="col-sm-9">@Model.Note</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
</div>
