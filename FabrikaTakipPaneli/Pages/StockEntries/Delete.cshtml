@page "{id:int}"
@model FabrikaTakipPaneli.Pages.StockEntries.DeleteModel
@{
    ViewData["Title"] = "Stok Hareketi Sil";
}

<h1>Stok Hareketi Sil</h1>

@if (!User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
{
    <p class="text-muted"><small>Kayıtlar sadece oluşturulduğu gün içinde silinebilir.</small></p>
}

<h3>Bu stok hareketini silmek istediğinize emin misiniz?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-2">Ürün</dt>
        <dd class="col-sm-10">@Model.ProductName</dd>
        <dt class="col-sm-2">Tip</dt>
        <dd class="col-sm-10">@(Model.Type == FabrikaTakipPaneli.Models.StockEntryType.In ? "Giriş" : "Çıkış")</dd>
        <dt class="col-sm-2">Miktar</dt>
        <dd class="col-sm-10">@Model.Quantity.ToString("N2")</dd>
        <dt class="col-sm-2">Tarih</dt>
        <dd class="col-sm-10">@Model.EntryDate.ToString("g")</dd>
        <dt class="col-sm-2">Not</dt>
        <dd class="col-sm-10">@Model.Note</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
