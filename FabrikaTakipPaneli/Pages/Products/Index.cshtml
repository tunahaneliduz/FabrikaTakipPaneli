@page
@model FabrikaTakipPaneli.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Ürünler";
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Stok kataloğu</span>
        <h1>Ürünler</h1>
        <p>Ürün tanımlarını, tesis konumlarını, fiyatları ve güncel stok seviyelerini yönetin.</p>
    </div>
    @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Ürün
        </a>
    }
</div>

<form method="get" class="filter-toolbar">
    <div class="search-field">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="search" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ürün adına göre ara..." aria-label="Ürün ara" />
        </div>
    </div>
    <input type="hidden" name="Location" value="@Model.Location" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Temizle</a>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Location))
{
    <div class="alert active-filter d-flex justify-content-between align-items-center py-2 px-3 mb-3">
        <span><i class="bi bi-geo-alt"></i> Konuma göre filtrelendi: <strong>@Model.Location</strong></span>
        <a asp-page="Index" asp-route-SearchTerm="@Model.SearchTerm" class="btn btn-sm btn-outline-secondary"><i class="bi bi-x-lg"></i> Filtreyi Kaldır</a>
    </div>
}

<div class="data-card modern-table-card">
    <div class="table-card-head">
        <strong><i class="bi bi-boxes me-2"></i>Ürün listesi</strong>
        <span>Bu sayfada @Model.Products.Count kayıt</span>
    </div>
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Ürün</th>
                    <th>Kategori</th>
                    <th>Konum</th>
                    <th class="text-end">Birim Fiyat</th>
                    <th class="text-end">Mevcut Stok</th>
                    <th class="text-end"><span class="visually-hidden">İşlemler</span></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr><td colspan="6" class="data-card-empty"><i class="bi bi-inbox d-block fs-3 mb-2"></i>Arama ölçütlerine uygun ürün bulunamadı.</td></tr>
                }
                @foreach (var product in Model.Products)
                {
                    <tr>
                        <td class="product-name-cell">
                            <strong>@product.Name</strong>
                            <small>Birim: @product.Unit</small>
                        </td>
                        <td>@(string.IsNullOrWhiteSpace(product.Category) ? "—" : product.Category)</td>
                        <td><span class="location-pill"><i class="bi bi-geo-alt"></i>@(string.IsNullOrWhiteSpace(product.Location) ? "Belirtilmemiş" : product.Location)</span></td>
                        <td class="text-end font-mono">@product.UnitPrice.ToString("N2") ₺</td>
                        <td class="text-end"><span class="stock-pill @(product.CurrentStock <= 0 ? "is-empty" : "")"><i class="bi @(product.CurrentStock <= 0 ? "bi-exclamation-circle" : "bi-check-circle")"></i><span class="font-mono">@product.CurrentStock.ToString("N2")</span> @product.Unit</span></td>
                        <td class="text-end">
                            @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
                            {
                                <span class="table-actions">
                                    <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle" aria-label="@product.Name ürününü düzenle"><i class="bi bi-pencil"></i></a>
                                    <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" title="Sil" aria-label="@product.Name ürününü sil"><i class="bi bi-trash"></i></a>
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?> { ["SearchTerm"] = Model.SearchTerm, ["Location"] = Model.Location }
})" />
