@page
@model FabrikaTakipPaneli.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Ürünler";
}

<h1>Ürünler</h1>

@if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
{
    <p>
        <a asp-page="Create" class="btn btn-primary">Yeni Ürün</a>
    </p>
}

<form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ürün adına göre ara..." />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Temizle</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Birim</th>
            <th>Kategori</th>
            <th>Birim Fiyat</th>
            <th>Mevcut Stok</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model.Products)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Unit</td>
                <td>@product.Category</td>
                <td>@product.UnitPrice.ToString("N2")</td>
                <td>@product.CurrentStock.ToString("N2")</td>
                <td>
                    @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
                    {
                        <a asp-page="Edit" asp-route-id="@product.Id">Düzenle</a>
                        <span>|</span>
                        <a asp-page="Delete" asp-route-id="@product.Id">Sil</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?> { ["SearchTerm"] = Model.SearchTerm }
})" />
