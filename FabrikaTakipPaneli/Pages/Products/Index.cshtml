@page
@model FabrikaTakipPaneli.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Ürünler";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Ürünler</h1>
    @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
    {
        <a asp-page="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Yeni Ürün
        </a>
    }
</div>

<form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Ürün adına göre ara..." />
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Temizle</a>
    </div>
</form>

<div class="data-card">
    <table class="table">
        <thead>
            <tr>
                <th>Ad</th>
                <th>Birim</th>
                <th>Kategori</th>
                <th>Konum</th>
                <th class="text-end">Birim Fiyat</th>
                <th class="text-end">Mevcut Stok</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Products.Count == 0)
            {
                <tr><td colspan="7" class="data-card-empty">Ürün bulunamadı.</td></tr>
            }
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Unit</td>
                    <td>@product.Category</td>
                    <td>@product.Location</td>
                    <td class="text-end">@product.UnitPrice.ToString("N2")</td>
                    <td class="text-end">@product.CurrentStock.ToString("N2")</td>
                    <td class="text-end">
                        @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
                        {
                            <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                            <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?> { ["SearchTerm"] = Model.SearchTerm }
})" />
