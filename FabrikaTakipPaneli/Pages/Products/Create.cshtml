@page
@model FabrikaTakipPaneli.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Yeni Ürün";
}

<h1><i class="bi bi-plus-lg"></i> Yeni Ürün</h1>

<div class="panel" style="max-width: 640px;">
<div class="panel-body">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-2">
        <label asp-for="Input.Name" class="control-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Unit" class="control-label"></label>
        <input asp-for="Input.Unit" class="form-control" />
        <span asp-validation-for="Input.Unit" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Category" class="control-label"></label>
        <input asp-for="Input.Category" class="form-control" />
        <span asp-validation-for="Input.Category" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.UnitPrice" class="control-label"></label>
        <input asp-for="Input.UnitPrice" class="form-control" />
        <span asp-validation-for="Input.UnitPrice" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.MinStockLevel" class="control-label"></label>
        <input asp-for="Input.MinStockLevel" class="form-control" />
        <small class="form-text text-muted">Boş bırakılırsa kritik stok durumu için 0 eşiği kullanılır.</small>
        <span asp-validation-for="Input.MinStockLevel" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Input.Description" class="control-label"></label>
        <textarea asp-for="Input.Description" class="form-control"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
