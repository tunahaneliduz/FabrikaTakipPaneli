@page "{id:int}"
@model FabrikaTakipPaneli.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Ürün Sil";
}

<h1>Ürün Sil</h1>

<h3>Bu ürünü silmek istediğinize emin misiniz?</h3>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Ad</dt>
        <dd class="col-sm-10">@Model.Product.Name</dd>
        <dt class="col-sm-2">Birim</dt>
        <dd class="col-sm-10">@Model.Product.Unit</dd>
        <dt class="col-sm-2">Kategori</dt>
        <dd class="col-sm-10">@Model.Product.Category</dd>
        <dt class="col-sm-2">Birim Fiyat</dt>
        <dd class="col-sm-10">@Model.Product.UnitPrice.ToString("N2")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Product.Id" />
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
