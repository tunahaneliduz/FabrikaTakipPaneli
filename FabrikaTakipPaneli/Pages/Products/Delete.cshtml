@page "{id:int}"
@model FabrikaTakipPaneli.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Ürün Sil";
}

<h1><i class="bi bi-trash"></i> Ürün Sil</h1>

<h3>Bu ürünü silmek istediğinize emin misiniz?</h3>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage</div>
}

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
    <dl class="row">
        <dt class="col-sm-3">Ad</dt>
        <dd class="col-sm-9">@Model.Product.Name</dd>
        <dt class="col-sm-3">Birim</dt>
        <dd class="col-sm-9">@Model.Product.Unit</dd>
        <dt class="col-sm-3">Kategori</dt>
        <dd class="col-sm-9">@Model.Product.Category</dd>
        <dt class="col-sm-3">Birim Fiyat</dt>
        <dd class="col-sm-9">@Model.Product.UnitPrice.ToString("N2")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Product.Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
</div>
