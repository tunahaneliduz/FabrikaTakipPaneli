<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <script>
        (function () {
            var stored = localStorage.getItem('theme');
            var theme = stored === 'dark' || stored === 'light'
                ? stored
                : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', theme);
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FabrikaTakipPaneli</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FabrikaTakipPaneli.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentPath = Context.Request.Path.Value ?? "";
        bool IsActive(string prefix) =>
            currentPath.Equals(prefix, StringComparison.OrdinalIgnoreCase) ||
            currentPath.StartsWith(prefix + "/", StringComparison.OrdinalIgnoreCase);
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar mb-4">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">
                    <i class="bi bi-diagram-3-fill"></i>
                    FabrikaTakipPaneli
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(currentPath == "/" || currentPath.Equals("/Index", StringComparison.OrdinalIgnoreCase) ? "active" : "")" asp-area="" asp-page="/Index">
                                <i class="bi bi-house"></i> Ana Sayfa
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(IsActive("/Dashboard") ? "active" : "")" asp-area="" asp-page="/Dashboard/Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(IsActive("/Products") ? "active" : "")" asp-area="" asp-page="/Products/Index">
                                    <i class="bi bi-box-seam"></i> Ürünler
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(IsActive("/StockEntries") ? "active" : "")" asp-area="" asp-page="/StockEntries/Index">
                                    <i class="bi bi-arrow-left-right"></i> Stok Hareketleri
                                </a>
                            </li>
                            @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link app-nav-link @(IsActive("/Admin") ? "active" : "")" asp-area="" asp-page="/Admin/Users/Index">
                                        <i class="bi bi-people"></i> Kullanıcılar
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <partial name="_LoginPartial" />
                        <button id="themeToggle" type="button" class="theme-toggle" title="Tema değiştir" aria-label="Tema değiştir">
                            <i class="bi bi-sun"></i>
                            <i class="bi bi-moon-stars"></i>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-main">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - FabrikaTakipPaneli - <a asp-area="" asp-page="/Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
