<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script>
    // Sunucu kültürü tr-TR (ondalık ayırıcı virgül) olduğu için jQuery Validate'in
    // sayı ve aralık doğrulamalarını virgüllü ondalık girişini de kabul edecek şekilde genişletiyoruz.
    $.validator.methods.number = function (value, element) {
        return this.optional(element) || /^-?\d+([.,]\d+)?$/.test(value);
    };

    $.validator.methods.range = function (value, element, param) {
        var normalized = parseFloat(String(value).replace(',', '.'));
        return this.optional(element) || (!isNaN(normalized) && normalized >= param[0] && normalized <= param[1]);
    };
</script>
