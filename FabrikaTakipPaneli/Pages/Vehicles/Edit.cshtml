@page "{id:int}"
@model FabrikaTakipPaneli.Pages.Vehicles.EditModel
@{
    ViewData["Title"] = "Araç Düzenle";
}

<h1><i class="bi bi-pencil"></i> Araç Düzenle</h1>

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
<form method="post">
    <input type="hidden" asp-for="Input.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-2">
        <label asp-for="Input.PlateNumber" class="control-label"></label>
        <input asp-for="Input.PlateNumber" class="form-control" />
        <span asp-validation-for="Input.PlateNumber" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Capacity" class="control-label"></label>
        <input asp-for="Input.Capacity" class="form-control" placeholder="Örn. 30 Ton" />
        <span asp-validation-for="Input.Capacity" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Input.VehicleType" class="control-label"></label>
        <input asp-for="Input.VehicleType" class="form-control" placeholder="Örn. Tır/Kamyon" />
        <span asp-validation-for="Input.VehicleType" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
