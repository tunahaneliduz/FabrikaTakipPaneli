@page "{id:int}"
@model FabrikaTakipPaneli.Pages.Vehicles.DeleteModel
@{
    ViewData["Title"] = "Araç Sil";
}

<h1><i class="bi bi-trash"></i> Araç Sil</h1>

<h3>Bu aracı silmek istediğinize emin misiniz?</h3>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage</div>
}

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
    <dl class="row">
        <dt class="col-sm-3">Plaka</dt>
        <dd class="col-sm-9">@Model.Vehicle.PlateNumber</dd>
        <dt class="col-sm-3">Kapasite</dt>
        <dd class="col-sm-9">@Model.Vehicle.Capacity</dd>
        <dt class="col-sm-3">Araç Tipi</dt>
        <dd class="col-sm-9">@Model.Vehicle.VehicleType</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Vehicle.Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
</div>
