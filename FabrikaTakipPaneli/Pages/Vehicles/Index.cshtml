@page
@model FabrikaTakipPaneli.Pages.Vehicles.IndexModel
@{
    ViewData["Title"] = "Araçlar";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Araçlar</h1>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Yeni Araç
    </a>
</div>

<form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Plakaya göre ara..." />
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Temizle</a>
    </div>
</form>

<div class="data-card">
    <table class="table">
        <thead>
            <tr>
                <th>Plaka</th>
                <th>Kapasite</th>
                <th>Araç Tipi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Vehicles.Count == 0)
            {
                <tr><td colspan="4" class="data-card-empty">Araç bulunamadı.</td></tr>
            }
            @foreach (var vehicle in Model.Vehicles)
            {
                <tr>
                    <td class="font-mono">@vehicle.PlateNumber</td>
                    <td>@vehicle.Capacity</td>
                    <td>@vehicle.VehicleType</td>
                    <td class="text-end">
                        <a asp-page="Edit" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-secondary" title="Düzenle"><i class="bi bi-pencil"></i></a>
                        <a asp-page="Delete" asp-route-id="@vehicle.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?> { ["SearchTerm"] = Model.SearchTerm }
})" />
