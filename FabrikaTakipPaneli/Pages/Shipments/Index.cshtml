@page
@using FabrikaTakipPaneli.Models
@model FabrikaTakipPaneli.Pages.Shipments.IndexModel
@{
    ViewData["Title"] = "Sevkiyatlar";
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1 class="mb-0">Sevkiyatlar</h1>
</div>

<form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="SearchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Seri no veya varış yerine göre ara..." />
        </div>
    </div>
    <div class="col-12">
        <select name="StatusFilter" class="form-control">
            <option value="">-- Tüm Durumlar --</option>
            @foreach (ShipmentStatus status in Enum.GetValues<ShipmentStatus>())
            {
                <option value="@status" selected="@(Model.StatusFilter == status)">@status.ToDisplayLabel()</option>
            }
        </select>
    </div>
    <div class="col-12">
        <label class="me-1">Başlangıç:</label>
        <input type="date" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12">
        <label class="me-1">Bitiş:</label>
        <input type="date" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Ara</button>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> Temizle</a>
    </div>
</form>

<div class="data-card">
    <table class="table">
        <thead>
            <tr>
                <th>Seri No</th>
                <th>Ürün</th>
                <th class="text-end">Toplam Tutar</th>
                <th>Varış Yeri</th>
                <th>Araç / Sürücü</th>
                <th>Yola Çıkış</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Shipments.Count == 0)
            {
                <tr><td colspan="8" class="data-card-empty">Sevkiyat bulunamadı.</td></tr>
            }
            @foreach (var shipment in Model.Shipments)
            {
                <tr>
                    <td class="font-mono">@shipment.OrderNumber</td>
                    <td>@shipment.ProductName</td>
                    <td class="text-end font-mono">@shipment.TotalAmount.ToString("N2")</td>
                    <td>@shipment.Destination</td>
                    <td>@shipment.TruckPlate @shipment.DriverName</td>
                    <td class="font-mono">@shipment.DepartureTime.ToString("g")</td>
                    <td><span class="badge @shipment.Status.ToBadgeClass()">@shipment.Status.ToDisplayLabel()</span></td>
                    <td class="text-end">
                        <a asp-page="Details" asp-route-id="@shipment.Id" class="btn btn-sm btn-outline-secondary" title="Detay"><i class="bi bi-eye"></i></a>
                        @if (User.IsInRole(FabrikaTakipPaneli.Authorization.AppRoles.Admin))
                        {
                            <a asp-page="Delete" asp-route-id="@shipment.Id" class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="@(new FabrikaTakipPaneli.Pages.Shared.PaginationViewModel
{
    CurrentPage = Model.PageIndex,
    TotalPages = Model.TotalPages,
    PageName = "Index",
    RouteData = new Dictionary<string, string?>
    {
        ["SearchTerm"] = Model.SearchTerm,
        ["StatusFilter"] = Model.StatusFilter?.ToString(),
        ["StartDate"] = Model.StartDate?.ToString("yyyy-MM-dd"),
        ["EndDate"] = Model.EndDate?.ToString("yyyy-MM-dd")
    }
})" />
