@page "{id:int}"
@model FabrikaTakipPaneli.Pages.Drivers.DeleteModel
@{
    ViewData["Title"] = "Sürücü Sil";
}

<h1><i class="bi bi-trash"></i> Sürücü Sil</h1>

<h3>Bu sürücüyü silmek istediğinize emin misiniz?</h3>

@if (Model.ErrorMessage is not null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage</div>
}

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
    <dl class="row">
        <dt class="col-sm-3">Ad Soyad</dt>
        <dd class="col-sm-9">@Model.Driver.FullName</dd>
        <dt class="col-sm-3">TC Kimlik No</dt>
        <dd class="col-sm-9">@Model.Driver.TCKimlikNo</dd>
        <dt class="col-sm-3">Telefon</dt>
        <dd class="col-sm-9">@Model.Driver.Phone</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Driver.Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Sil</button>
        <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
    </form>
</div>
</div>
