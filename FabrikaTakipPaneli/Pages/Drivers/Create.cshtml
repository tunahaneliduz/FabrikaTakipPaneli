@page
@model FabrikaTakipPaneli.Pages.Drivers.CreateModel
@{
    ViewData["Title"] = "Yeni Sürücü";
}

<h1><i class="bi bi-plus-lg"></i> Yeni Sürücü</h1>

<div class="panel" style="max-width: 720px;">
<div class="panel-body">
<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group mb-2">
        <label asp-for="Input.FullName" class="control-label"></label>
        <input asp-for="Input.FullName" class="form-control" />
        <span asp-validation-for="Input.FullName" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.TCKimlikNo" class="control-label"></label>
        <input asp-for="Input.TCKimlikNo" class="form-control" maxlength="11" autocomplete="off" />
        <small class="form-text text-muted"><i class="bi bi-shield-lock"></i> Bu bilgi hassastır, gerçek sistemlerde şifrelenir.</small>
        <span asp-validation-for="Input.TCKimlikNo" class="text-danger"></span>
    </div>
    <div class="form-group mb-2">
        <label asp-for="Input.Phone" class="control-label"></label>
        <input asp-for="Input.Phone" class="form-control" />
        <span asp-validation-for="Input.Phone" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="Input.LicenseNumber" class="control-label"></label>
        <input asp-for="Input.LicenseNumber" class="form-control" />
        <span asp-validation-for="Input.LicenseNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet</button>
    <a asp-page="Index" class="btn btn-secondary">Vazgeç</a>
</form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
