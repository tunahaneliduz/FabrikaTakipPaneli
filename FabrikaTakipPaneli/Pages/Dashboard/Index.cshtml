@page
@model FabrikaTakipPaneli.Pages.Dashboard.IndexModel
@using System.Text.Json
@using FabrikaTakipPaneli.Models
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card kpi-accent">
            <div class="kpi-icon"><i class="bi bi-box-seam"></i></div>
            <div>
                <div class="kpi-value font-mono">@Model.TotalProductCount</div>
                <div class="kpi-label">Toplam Ürün Sayısı</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card kpi-neutral">
            <div class="kpi-icon"><i class="bi bi-arrow-left-right"></i></div>
            <div>
                <div class="kpi-value font-mono">@Model.TotalStockEntryCount</div>
                <div class="kpi-label">Toplam Stok Hareketi</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card kpi-info">
            <div class="kpi-icon"><i class="bi bi-calendar-check"></i></div>
            <div>
                <div class="kpi-value font-mono">@Model.TodayEntryCount</div>
                <div class="kpi-label">Bugünkü Hareket Sayısı</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="kpi-card kpi-danger">
            <div class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></div>
            <div>
                <div class="kpi-value font-mono">@Model.CriticalStockProductCount</div>
                <div class="kpi-label">Kritik Stoklu Ürün (Min Eşik Altı)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="panel">
            <div class="panel-header"><i class="bi bi-geo-alt me-1"></i> Bölümlere Göre Stok</div>
            <div class="panel-body">
                <div class="location-grid">
                    @if (Model.LocationSummaries.Count == 0)
                    {
                        <p class="text-muted mb-0">Ürün bulunamadı.</p>
                    }
                    @foreach (var loc in Model.LocationSummaries)
                    {
                        <div class="location-card @(loc.CriticalCount > 0 ? "has-critical" : "")">
                            <div class="location-name"><i class="bi bi-geo-alt-fill"></i> @loc.Location</div>
                            <div class="location-stats">
                                <span>@loc.ProductCount ürün</span>
                                @if (loc.CriticalCount > 0)
                                {
                                    <span class="critical"><i class="bi bi-exclamation-triangle"></i> @loc.CriticalCount kritik stoklu ürün</span>
                                }
                                else
                                {
                                    <span>Kritik stok yok</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-exclamation-diamond me-1"></i> Kritik Stok - En Düşük Stoklu Ürünler</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Birim</th>
                            <th class="text-end">Mevcut Stok</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LowStockProducts.Count == 0)
                        {
                            <tr><td colspan="3" class="data-card-empty">Ürün bulunamadı.</td></tr>
                        }
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.Unit</td>
                                <td class="text-end font-mono">
                                    @if (p.IsCritical)
                                    {
                                        <span class="badge text-bg-danger">@p.CurrentStock.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        @p.CurrentStock.ToString("N2")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-clock-history me-1"></i> Son Stok Hareketleri</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Tip</th>
                            <th class="text-end">Miktar</th>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentEntries.Count == 0)
                        {
                            <tr><td colspan="5" class="data-card-empty">Hareket bulunamadı.</td></tr>
                        }
                        @foreach (var e in Model.RecentEntries)
                        {
                            <tr>
                                <td>@e.ProductName</td>
                                <td>
                                    @if (e.Type == StockEntryType.In)
                                    {
                                        <span class="badge text-bg-success">Giriş</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-warning">Çıkış</span>
                                    }
                                </td>
                                <td class="text-end font-mono">@e.Quantity.ToString("N2")</td>
                                <td class="font-mono">@e.EntryDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@e.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-bar-chart me-1"></i> En Düşük Stoklu Ürünler (Grafik)</div>
            <div class="panel-body">
                <canvas id="lowStockChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-graph-up me-1"></i> Son @Model.TrendChartLabels.Count Günlük Giriş/Çıkış Trendi</div>
            <div class="panel-body">
                <canvas id="trendChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        const lowStockLabels = @Html.Raw(JsonSerializer.Serialize(Model.LowStockChartLabels));
        const lowStockValues = @Html.Raw(JsonSerializer.Serialize(Model.LowStockChartValues));
        const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartLabels));
        const trendInValues = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartInValues));
        const trendOutValues = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartOutValues));

        const rootStyles = getComputedStyle(document.documentElement);
        const chartTextColor = rootStyles.getPropertyValue('--bs-secondary-color').trim();
        const chartGridColor = rootStyles.getPropertyValue('--bs-border-color').trim();
        const chartAccent = rootStyles.getPropertyValue('--app-accent').trim();
        const chartWarning = rootStyles.getPropertyValue('--bs-warning').trim();

        Chart.defaults.font.family = "'Inter Variable', 'Inter', sans-serif";
        Chart.defaults.color = chartTextColor;
        Chart.defaults.borderColor = chartGridColor;

        new Chart(document.getElementById('lowStockChart'), {
            type: 'bar',
            data: {
                labels: lowStockLabels,
                datasets: [{
                    label: 'Mevcut Stok',
                    data: lowStockValues,
                    backgroundColor: lowStockValues.map(v => v <= 0 ? '#dc3545' : chartAccent),
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: chartGridColor } },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Giriş',
                        data: trendInValues,
                        borderColor: chartAccent,
                        backgroundColor: chartAccent,
                        tension: 0.3
                    },
                    {
                        label: 'Çıkış',
                        data: trendOutValues,
                        borderColor: chartWarning,
                        backgroundColor: chartWarning,
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true, grid: { color: chartGridColor } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
