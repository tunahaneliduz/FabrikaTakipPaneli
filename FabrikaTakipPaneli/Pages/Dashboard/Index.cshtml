@page
@model FabrikaTakipPaneli.Pages.Dashboard.IndexModel
@using System.Text.Json
@using FabrikaTakipPaneli.Models
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <div>
        <span class="page-kicker">Analitik görünüm</span>
        <h1>Operasyon Dashboard’u</h1>
        <p>Stok sağlığını, günlük hareketleri ve tesis bölümlerini gerçek zamanlı operasyon verileriyle değerlendirin.</p>
    </div>
    <a asp-page="/StockEntries/Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Yeni Stok Hareketi</a>
</div>

<section class="kpi-grid" aria-label="Dashboard göstergeleri">
    <article class="kpi-card kpi-neutral">
        <div class="kpi-topline"><span class="kpi-label">Toplam ürün</span><span class="kpi-icon"><i class="bi bi-box-seam"></i></span></div>
        <strong class="kpi-value">@Model.TotalProductCount</strong>
        <span class="kpi-meta">Portföyde takip edilen ürün</span>
    </article>
    <article class="kpi-card">
        <div class="kpi-topline"><span class="kpi-label">Toplam hareket</span><span class="kpi-icon"><i class="bi bi-database"></i></span></div>
        <strong class="kpi-value">@Model.TotalStockEntryCount</strong>
        <span class="kpi-meta">Tüm zamanların stok kaydı</span>
    </article>
    <article class="kpi-card kpi-positive">
        <div class="kpi-topline"><span class="kpi-label">Bugün</span><span class="kpi-icon"><i class="bi bi-activity"></i></span></div>
        <strong class="kpi-value">@Model.TodayEntryCount</strong>
        <span class="kpi-meta">Gün içinde gerçekleşen hareket</span>
    </article>
    <article class="kpi-card @(Model.CriticalStockProductCount > 0 ? "kpi-critical" : "kpi-positive")">
        <div class="kpi-topline"><span class="kpi-label">Kritik stok</span><span class="kpi-icon"><i class="bi bi-exclamation-triangle"></i></span></div>
        <strong class="kpi-value">@Model.CriticalStockProductCount</strong>
        <span class="kpi-meta">Minimum seviyenin altındaki ürün</span>
    </article>
</section>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="panel">
            <div class="panel-header"><i class="bi bi-geo-alt me-1"></i> Bölümlere Göre Stok<span class="panel-caption">Tesis alanlarının ürün ve kritik stok dağılımı</span></div>
            <div class="panel-body">
                <div class="location-grid">
                    @if (Model.LocationSummaries.Count == 0)
                    {
                        <p class="text-muted mb-0">Ürün bulunamadı.</p>
                    }
                    @foreach (var loc in Model.LocationSummaries)
                    {
                        <div class="location-card @(loc.CriticalCount > 0 ? "has-critical" : "")">
                            <div class="location-name"><i class="bi bi-geo-alt-fill"></i> @loc.Location</div>
                            <div class="location-stats">
                                <span>@loc.ProductCount ürün</span>
                                @if (loc.CriticalCount > 0)
                                {
                                    <span class="critical"><i class="bi bi-exclamation-triangle"></i> @loc.CriticalCount kritik stoklu ürün</span>
                                }
                                else
                                {
                                    <span>Kritik stok yok</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-exclamation-diamond me-1"></i> Kritik Stok<span class="panel-caption">En düşük stok seviyesine sahip ürünler</span></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Birim</th>
                            <th class="text-end">Mevcut Stok</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.LowStockProducts.Count == 0)
                        {
                            <tr><td colspan="3" class="data-card-empty">Ürün bulunamadı.</td></tr>
                        }
                        @foreach (var p in Model.LowStockProducts)
                        {
                            <tr>
                                <td>@p.Name</td>
                                <td>@p.Unit</td>
                                <td class="text-end font-mono">
                                    @if (p.IsCritical)
                                    {
                                        <span class="badge text-bg-danger">@p.CurrentStock.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        @p.CurrentStock.ToString("N2")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-clock-history me-1"></i> Son Stok Hareketleri<span class="panel-caption">Operasyon akışındaki son kayıtlar</span></div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Ürün</th>
                            <th>Tip</th>
                            <th class="text-end">Miktar</th>
                            <th>Tarih</th>
                            <th>Kullanıcı</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentEntries.Count == 0)
                        {
                            <tr><td colspan="5" class="data-card-empty">Hareket bulunamadı.</td></tr>
                        }
                        @foreach (var e in Model.RecentEntries)
                        {
                            <tr>
                                <td>@e.ProductName</td>
                                <td>
                                    @if (e.Type == StockEntryType.In)
                                    {
                                        <span class="badge text-bg-success">Giriş</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-primary">Çıkış</span>
                                    }
                                </td>
                                <td class="text-end font-mono">@e.Quantity.ToString("N2")</td>
                                <td class="font-mono">@e.EntryDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@e.UserName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-bar-chart me-1"></i> Stok Seviyesi<span class="panel-caption">En düşük stoklu ürünlerin karşılaştırması</span></div>
            <div class="panel-body">
                <canvas id="lowStockChart" height="220"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="panel h-100">
            <div class="panel-header"><i class="bi bi-graph-up me-1"></i> Giriş / Çıkış Trendi<span class="panel-caption">Son @Model.TrendChartLabels.Count günlük hareket analizi</span></div>
            <div class="panel-body">
                <canvas id="trendChart" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js"></script>
    <script>
        const lowStockLabels = @Html.Raw(JsonSerializer.Serialize(Model.LowStockChartLabels));
        const lowStockValues = @Html.Raw(JsonSerializer.Serialize(Model.LowStockChartValues));
        const trendLabels = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartLabels));
        const trendInValues = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartInValues));
        const trendOutValues = @Html.Raw(JsonSerializer.Serialize(Model.TrendChartOutValues));

        const rootStyles = getComputedStyle(document.documentElement);
        const chartTextColor = rootStyles.getPropertyValue('--bs-secondary-color').trim();
        const chartGridColor = rootStyles.getPropertyValue('--bs-border-color').trim();
        const chartAccent = rootStyles.getPropertyValue('--app-accent').trim();
        const chartDanger = rootStyles.getPropertyValue('--bs-danger').trim();

        Chart.defaults.font.family = "'Inter Variable', 'Inter', sans-serif";
        Chart.defaults.color = chartTextColor;
        Chart.defaults.borderColor = chartGridColor;

        new Chart(document.getElementById('lowStockChart'), {
            type: 'bar',
            data: {
                labels: lowStockLabels,
                datasets: [{
                    label: 'Mevcut Stok',
                    data: lowStockValues,
                    backgroundColor: lowStockValues.map(v => v <= 0 ? '#dc3545' : chartAccent),
                    borderRadius: 6
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: chartGridColor } },
                    x: { grid: { display: false } }
                }
            }
        });

        new Chart(document.getElementById('trendChart'), {
            type: 'line',
            data: {
                labels: trendLabels,
                datasets: [
                    {
                        label: 'Giriş',
                        data: trendInValues,
                        borderColor: chartAccent,
                        backgroundColor: chartAccent,
                        tension: 0.3
                    },
                    {
                        label: 'Çıkış',
                        data: trendOutValues,
                        borderColor: chartDanger,
                        backgroundColor: chartDanger,
                        tension: 0.3
                    }
                ]
            },
            options: {
                responsive: true,
                scales: {
                    y: { beginAtZero: true, grid: { color: chartGridColor } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}
