@page
@model RegisterModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="d-flex justify-content-center">
<div class="panel" style="max-width: 420px; width: 100%;">
<div class="panel-body">
    <h1 class="h3 mb-1 text-center">Kayıt Ol</h1>
    <p class="text-muted text-center mb-4">Yeni bir hesap oluşturun.</p>
    <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-group mb-2">
            <label asp-for="Input.Email" class="control-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ornek@sirket.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.Password" class="control-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Input.ConfirmPassword" class="control-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Şifre (tekrar)" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button id="registerSubmit" type="submit" class="w-100 btn btn-primary">Kayıt Ol</button>
        <div class="text-center mt-3">
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Zaten hesabınız var mı? Giriş yapın</a>
        </div>
    </form>
</div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
