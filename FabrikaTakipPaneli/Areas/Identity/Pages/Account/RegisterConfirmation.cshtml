@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Kayıt onayı";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    Bu uygulamada şu anda gerçek bir e-posta gönderici kayıtlı değil, gerçek bir e-posta gönderici yapılandırmak için <a href="https://aka.ms/aspaccountconf">bu dokümanlara</a> bakın.
    Normalde bu e-posta ile gönderilirdi: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Hesabınızı onaylamak için buraya tıklayın</a>
</p>
    }
    else
    {
<p>
        Hesabınızı onaylamak için lütfen e-postanızı kontrol edin.
</p>
    }
}

