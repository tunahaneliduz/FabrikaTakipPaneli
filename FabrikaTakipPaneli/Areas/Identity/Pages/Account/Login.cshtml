@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="d-flex justify-content-center">
<div class="panel" style="max-width: 420px; width: 100%;">
<div class="panel-body">
    <h1 class="h3 mb-1 text-center">Giriş Yap</h1>
    <p class="text-muted text-center mb-4">Hesabınıza erişmek için bilgilerinizi girin.</p>
    <form id="account" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="form-group mb-2">
            <label asp-for="Input.Email" class="control-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ornek@sirket.com" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-group mb-2">
            <label asp-for="Input.Password" class="control-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Şifre" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input class="form-check-input" asp-for="Input.RememberMe" />
            <label class="form-check-label" asp-for="Input.RememberMe">Beni hatırla</label>
        </div>
        <button id="login-submit" type="submit" class="w-100 btn btn-primary">Giriş Yap</button>
        <div class="text-center mt-3">
            <a id="forgot-password" asp-page="./ForgotPassword">Şifrenizi mi unuttunuz?</a>
        </div>
        <div class="text-center mt-1">
            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Hesabınız yok mu? Kayıt olun</a>
        </div>
    </form>
</div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
