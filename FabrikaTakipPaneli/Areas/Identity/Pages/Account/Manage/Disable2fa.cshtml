@page
@model Disable2faModel
@{
    ViewData["Title"] = "İki Faktörlü Doğrulamayı Devre Dışı Bırak (2FA)";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Bu işlem yalnızca 2FA'yı devre dışı bırakır.</strong>
    </p>
    <p>
        2FA'yı devre dışı bırakmak, authenticator uygulamalarında kullanılan anahtarları değiştirmez. Authenticator
        uygulamasında kullanılan anahtarı değiştirmek isterseniz <a asp-page="./ResetAuthenticator">authenticator anahtarlarınızı sıfırlamalısınız.</a>
    </p>
</div>

<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">2FA'yı devre dışı bırak</button>
    </form>
</div>
